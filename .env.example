# ── مطلوب ──
# مجلد البوت (finbot_v4_1 منسوخ باسم bot جنب main.py). في Docker: /app/bot (متظبط في الـ Dockerfile)
BOT_DIR=./bot

# ── التشغيل ──
ANSWERS_FILE=answers.txt   # جوه BOT_DIR
MAX_JOBS=1                 # جلسات متزامنة. كل واحدة = Chromium ≈ 300-500MB رام. زوّدها حسب رام الخطة
MAX_QUEUE=10
JOB_TIMEOUT_MIN=240        # بعد المدة دي الحل بيتوقف بحالة "timeout"
DB_PATH=./bot/web.db       # على Railway: /data/web.db مع Volume على /data

# ── الأمان ──
ALLOWED_ORIGINS=           # دومينات إضافية مسموحة (فاضي = نفس الدومين بس)
TRUST_PROXY=1              # 1 على Railway/Nginx عشان الـ rate limit يقرا IP الزائر الحقيقي
RESULT_TTL_MIN=30          # بنحتفظ بنتيجة الحل كام دقيقة بعد ما يخلص (للرجوع بعد قفل الصفحة)
WS_RATE_LIMIT=6            # أقصى محاولات حل في الدقيقة لكل IP

# ── متغيرات محرّك البوت (القيم دي هي الافتراضية في v4.1 — سيبها إلا لو قست الفرق) ──
BLOCK_ASSETS=false         # ⚠️ سيبها false: كاتب البوت قاس إن الحجب بيعطّل الـ HTTP cache وممكن يعلّق شاشة تحميل المنصة
RETRIES=2
MAX_STEPS=5000
WAIT_SHORT=150
WAIT_MEDIUM=250
WAIT_AFTER_ANSWER=250

# ── قياس (اختياري) ──
PROFILE_SLEEPS=0           # 1 = يطبع بعد كل حل كام ثانية ضاعت في sleep وفي أنهي سطر (شغّله مع MAX_JOBS=1)
PW_LAUNCH_FIX=0            # 1 = يضيف --disable-dev-shm-usage لأي launch (البوت v4.1 بيحطه أصلاً، فمش محتاجه)

# ❌ لا تضع BOT_TOKEN هنا — خدمة الويب مش محتاجاه.
