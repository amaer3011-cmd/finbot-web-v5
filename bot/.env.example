# ── مطلوب ──
BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE

# ── اختياري: معرّف تيليجرام الرقمي للمطوّر (من @userinfobot) ──
# لو تُرك فارغًا تتعطّل تقارير الأعطال ولا يُسأل الطالب عن الموافقة عليها.
OWNER_CHAT_ID=

# ── بنك الإجابات (ملف الأتمتة) — افتراضيًا answers.txt بجوار bot.py ──
ANSWERS_FILE=answers.txt   # يقبل بنك .txt أو Markdown منسقًا بصيغتي السؤال/الإجابة

# ── الأداء والتشغيل (القيم الحالية هي الافتراضية) ──
MAX_JOBS=1              # عدد الحسابات التي تُحل في نفس الوقت (1 للرام الصغير، 2 لو 1.5GB+)
MAX_QUEUE=10            # أقصى عدد منتظرين في الطابور
JOB_TIMEOUT_MIN=240     # أقصى مدة لكل حساب (دقائق)
RETRIES=2               # إعادة تشغيل المتصفح والمتابعة لو حصل انقطاع/مهلة
BLOCK_ASSETS=false      # منع تحميل الصور والخطوط؛ false يحافظ على تخزين المتصفح المؤقت واستقرار تحميل المنصة
MAX_STEPS=5000          # حد أمان لعدد الخطوات
WAIT_SHORT=150          # فترات الانتظار بالملّي ثانية (ارفعها لو حصلت نقرات فائتة)
WAIT_MEDIUM=250
WAIT_AFTER_ANSWER=250

# ── اختياري ──
DEV_USERNAME=
DB_PATH=bot.db          # على Railway: /data/bot.db (بيتظبط تلقائيًا في الـ Dockerfile)
